+def _family(fill):
+    pairs = [*RB.ANGLE_SET, (0.37, 0.61)]
+    circuits = []
+    for a, b in pairs:
+        qc = QuantumCircuit(2)
+        fill(qc, a, b)
+        circuits.append(qc)
+    return circuits, pairs
+
+
+def _clifford(qc, a, b):
+    qc.rz(a - PI, 0); qc.cx(0, 1); qc.rz(b - 3 * PI / 2, 1); qc.p(a + PI / 2, 0); qc.s(1); qc.crz(2 * b + PI, 0, 1)
+
