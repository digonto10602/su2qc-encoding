namespace Su2PlaqCert.LSH.Pins

def statesSha256 : String := "3e28faecaf690fde84aa15d3c86607a2a97dab52b9a3a339f14341e15eb2f0b2"

/-- `(d_alpha, d_beta)` of the exact targets. -/
def targetBase (kind : String) (order : Nat) : Option (Nat × Nat) :=
  match kind, order with
  | "UE", _ => some (4, 4)
  | "UB", _ => some (4, 4)
  | "step", 1 => some (4, 4)
  | "step", 2 => some (8, 4)
  | _, _ => none

